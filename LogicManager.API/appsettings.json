{
  "MongoDb": {
    "ConnectionString": "mongodb://MongoDB:27017", //MongoDb Connection String // localhost idi fakat dockerda calısması icin mongodb yapıldı
    "DatabaseName": "Tram34", //MongoDb Database Name
    "CollectionName": "TrainDB", //MongoDb Collection Name
    "TrainId": "Train 1" //Train Id
  },
  "RabbitMQ": {
    "Host": "RabbitMQ" // veya RabbitMQ sunucunuzun adresi
  },
  "ConnectionStrings": {
    "TakoConnection": "http://100.10.155.25/api/slot/0/io/di", //Tako verisini test amaçlı okudugumuz controller ın Connection String
    "Urls": "http://localhost:3405" // Uygulamanın çalıştığı Url
  },
  "LogAliveStatus": {
    "ImAliveIntervalSeconds": 10, //Kaç saniyede bir alive logu atılacak
    "LogIntervalSecondsDistance": 30 //Kaç saniyede bir distance verileri servislere gönderilecek
  },
  "LogEndpoints": { //Logları göndermek istediğimiz servislerin endpointleri. MongoDb olmasaydı burdan okunacaktı
    "Alarm": true,
    "Error": true,
    "Event": true,
    "Information": true,
    "Warning": true

  },
  "TcmsSettings": {
    "isLider": "True",
    "istasyondanCıkısMesafesi": 15, //İstasyondan çıktıktan sonra verileri servislere gönderecegi mesafe
    "TakoDataType": "Pulse", //TCMS tako veri tipi: "Pulse" (TachoMeterPulse true/false) veya "Meter" (TachoMeterDistance metraj)
    "PulseDistanceMeters": 2, //Pulse modunda her durum değişiminin metre karşılığı
    "CountBothEdges": true //true: true->false ve false->true ikisi de sayılır. false: sadece false->true sayılır
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "None", //Http Console loglarını görmemek için
      "LogicManager.Shared.Helpers.LoggerHelper": "None"
    }
  },
  "AllowedHosts": "*"
}
